 QoQ.","summary":"Persistent Systems Q4 net profit rises to ₹5.3B, up from ₹4.4B QoQ.","url":"","imageUrl":null,"pubDate":"2026-04-21T15:34:22","source":"Livesquawk"},{"id":"590147","title":"HCL Tech, Nestle, Persistent Systems, Tata Elxsi, and others set to announce Q4 results.\nBoM, Groww, PNB Housing, Nelco, Indosolar, Navkar also in focus for market updates.","summary":"HCL Tech, Nestle, Persistent Systems, Tata Elxsi, and others set to announce Q4 results.\nBoM, Groww, PNB Housing, Nelco, Indosolar, Navkar also in focus for market updates.","url":"https://www.thehindubusinessline.com/companies/q4-results-today-live-updates-hcl-tech-nestle-paytm-persistent-systems-tata-elxsi-tata-investment-cmpdi-results-21-april-2026/article70885877.ece","imageUrl":null,"pubDate":"2026-04-21T09:23:33","source":"The Hindu Business Line"}]}]